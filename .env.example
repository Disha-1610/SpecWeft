# SQLite database used by CLI, API and hook (default: data/specweft.db)
SPECWEFT_DB=data/specweft.db
# Log level for CLI/API: DEBUG, INFO, WARNING
SPECWEFT_LOG=WARNING
# Stop hook: "block" (default; blocks at most once, only for high-confidence recommendations) or "warn" (never blocks)
SPECWEFT_HOOK_MODE=block
# Where the hook appends one JSON line per invocation (default: data/hook_log.jsonl)
SPECWEFT_HOOK_LOG=data/hook_log.jsonl
# Print hook tracebacks to stderr
SPECWEFT_DEBUG=
# --- Forge app backend (Forge Remote) ---
# Your Forge app id (from `forge register`); the audience every Forge Invocation Token must carry
SPECWEFT_FORGE_APP_ID=ari:cloud:ecosystem::app/REPLACE-ME
# Atlassian's signing keys for Forge Invocation Tokens
SPECWEFT_FORGE_JWKS_URL=https://forge.cdn.prod.atlassian-dev.net/.well-known/jwks.json
# Map Bitbucket repos to scanned repo names when they differ, e.g. {"myworkspace/orders-api": "orders"}
SPECWEFT_REPO_MAP={}
# "off" disables token verification — local development only, never in production
SPECWEFT_FORGE_AUTH=
# --- On-demand indexing (Forge app) ---
# Where public repos are cloned; git base URL (operator-controlled, never taken from requests)
SPECWEFT_REPOS_DIR=/data/repos/bitbucket
SPECWEFT_GIT_BASE=https://bitbucket.org
SPECWEFT_INDEX_TTL_HOURS=24
SPECWEFT_MAX_REPO_MB=300
SPECWEFT_CLONE_TIMEOUT=180
SPECWEFT_CLONE_DEPTH=500
SPECWEFT_INDEX_WORKERS=2
